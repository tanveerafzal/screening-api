# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL — shared with id-verify-api)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Backend Configuration
# Options: "yente" or "hosted"
SCREENING_BACKEND=yente

# Yente Configuration (when SCREENING_BACKEND=yente)
YENTE_BASE_URL=http://localhost:8000

# Hosted OpenSanctions API Configuration (when SCREENING_BACKEND=hosted)
OPENSANCTIONS_API_URL=https://api.opensanctions.org
OPENSANCTIONS_API_KEY=your-api-key-here

# Request Configuration
REQUEST_TIMEOUT_MS=30000
MAX_BATCH_SIZE=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Cove Webhook Configuration (optional)
COVE_WEBHOOK_URL=
COVE_WEBHOOK_API_KEY=
