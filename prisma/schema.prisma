generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Partner {
  id                  String      @id @default(uuid())
  companyName         String
  contactName         String
  contactEmail        String?
  apiKey              String      @unique @default(uuid())
  apiSecret           String      @default(uuid())
  isActive            Boolean     @default(true)
  tierId              String
  verificationsUsed   Int         @default(0)
  screeningsUsed      Int         @default(0)
  webhookUrl          String?
  screeningWebhookUrl String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tier                Tier        @relation(fields: [tierId], references: [id])
  screenings          Screening[] @relation("PartnerScreenings")

  @@index([apiKey])
  @@index([tierId])
}

model Tier {
  id                   String    @id @default(uuid())
  name                 String    @unique
  displayName          String
  monthlyPrice         Float
  yearlyPrice          Float
  monthlyVerifications Int
  apiCallsPerMinute    Int       @default(10)
  features             Json
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  partners             Partner[]

  @@index([name])
}

model Screening {
  id               String                  @id @default(uuid())
  partnerId        String?
  dataset          String
  status           ScreeningStatus         @default(PENDING)
  verdict          ScreeningVerdict?
  queriesCount     Int                     @default(0)
  flaggedCount     Int                     @default(0)
  reviewCount      Int                     @default(0)
  clearCount       Int                     @default(0)
  inputPayload     Json
  resultPayload    Json?
  ipAddress        String?
  userAgent        String?
  processingTimeMs Float?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  completedAt      DateTime?
  partner          Partner?                @relation("PartnerScreenings", fields: [partnerId], references: [id])
  webhookEvents    ScreeningWebhookEvent[]

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@index([dataset])
}

model ScreeningWebhookEvent {
  id               String    @id @default(uuid())
  screeningId      String
  eventType        String
  payload          Json
  delivered        Boolean   @default(false)
  deliveryAttempts Int       @default(0)
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  responseStatus   Int?
  responseBody     String?
  createdAt        DateTime  @default(now())
  screening        Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@index([screeningId])
  @@index([delivered])
  @@index([createdAt])
}

model RequestLogs {
  id                 String   @id @default(uuid())
  requestId          String   @unique
  timestamp          DateTime @default(now())
  method             String
  path               String
  queryParams        String?
  clientIp           String?
  userAgent          String?  @db.VarChar(500)
  requestContentType String?  @db.VarChar(100)
  requestFilename    String?
  requestFileSizeKb  Float?
  statusCode         Int
  responseBody       Json?
  processingTimeMs   Float?
  partnerId          String?
  error              String?

  @@index([timestamp])
  @@index([path])
  @@index([statusCode])
  @@index([partnerId])
  @@map("RequestLogs")
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ScreeningVerdict {
  CLEAR
  FLAG
  REVIEW
}
