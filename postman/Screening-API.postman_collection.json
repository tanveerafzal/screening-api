{
  "info": {
    "name": "Screening API",
    "description": "Sanctions screening API wrapper for OpenSanctions. Supports matching entities against watchlists, searching sanctions lists, and retrieving entity details.\n\n## Backends\n- **yente** - Self-hosted OpenSanctions instance\n- **hosted** - OpenSanctions hosted API (requires API key)\n\n## Configuration\nSet the `baseUrl` variable to point to your running instance (default: http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "dataset",
      "value": "default",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "description": "Health checks and service information endpoints.",
      "item": [
        {
          "name": "Health Check (Liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["healthz"]
            },
            "description": "Basic liveness probe. Returns 200 if the service is running."
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": ["{{baseUrl}}"],
              "path": ["readyz"]
            },
            "description": "Readiness probe. Returns 200 if the backend index is ready to serve requests."
          }
        },
        {
          "name": "Service Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/info",
              "host": ["{{baseUrl}}"],
              "path": ["info"]
            },
            "description": "Returns service metadata including version, backend type, and backend URL."
          }
        },
        {
          "name": "Catalog (List Datasets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["catalog"]
            },
            "description": "Lists all available datasets with entity counts, last change timestamps, and metadata."
          }
        },
        {
          "name": "List Algorithms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/algorithms",
              "host": ["{{baseUrl}}"],
              "path": ["algorithms"]
            },
            "description": "Lists available matching/scoring algorithms and indicates the default algorithm."
          }
        }
      ]
    },
    {
      "name": "Match",
      "description": "Match entities against sanctions watchlists. Supports batch queries with up to 50 entities per request.",
      "item": [
        {
          "name": "Match - Single Person",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": {\n    \"q1\": {\n      \"schema\": \"Person\",\n      \"properties\": {\n        \"name\": [\"Vladimir Putin\"],\n        \"birthDate\": [\"1952\"]\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/match/{{dataset}}?limit=5&threshold=0.7",
              "host": ["{{baseUrl}}"],
              "path": ["match", "{{dataset}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Max results per query (default: 5, max: 500)"
                },
                {
                  "key": "threshold",
                  "value": "0.7",
                  "description": "Minimum score threshold 0-1 (default: 0.7)"
                },
                {
                  "key": "algorithm",
                  "value": "best",
                  "description": "Scoring algorithm (default: best)",
                  "disabled": true
                },
                {
                  "key": "topics",
                  "value": "sanction",
                  "description": "Filter by topics: sanction, crime, pep",
                  "disabled": true
                },
                {
                  "key": "include_dataset",
                  "value": "",
                  "description": "Include specific datasets",
                  "disabled": true
                },
                {
                  "key": "exclude_dataset",
                  "value": "",
                  "description": "Exclude specific datasets",
                  "disabled": true
                },
                {
                  "key": "exclude_schema",
                  "value": "",
                  "description": "Exclude entity schemas",
                  "disabled": true
                }
              ]
            },
            "description": "Match a single person entity against sanctions watchlists by name and date of birth."
          }
        },
