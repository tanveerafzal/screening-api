    {
      "name": "Screen",
      "description": "Smart screening endpoint that categorizes matches by risk level and returns a verdict (CLEAR, FLAG, REVIEW).\n\nCategories: SANCTIONED (critical), TERRORISM (critical), WANTED (critical), FRAUD (high), CRIME (high), TRAFFICKING (high), PEP (medium), DEBARMENT (medium), POI (low), PEP_ASSOCIATE (low).",
      "item": [
        {
          "name": "Screen - Single Person",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": {\n    \"q1\": {\n      \"schema\": \"Person\",\n      \"properties\": {\n        \"name\": [\"Vladimir Putin\"],\n        \"birthDate\": [\"1952\"]\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/screen/{{dataset}}?threshold=0.7&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["screen", "{{dataset}}"],
              "query": [
                {
                  "key": "threshold",
                  "value": "0.7",
                  "description": "Minimum score threshold 0-1 (default: 0.7)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Max results per query (default: 10)"
                }
              ]
            },
            "description": "Screen a single person and get a categorized verdict with risk levels. Returns CLEAR, FLAG, or REVIEW."
